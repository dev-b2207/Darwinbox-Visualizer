{
  "name": "darwinbox-visualizer",
  "version": "4.5.1",
  "description": "Darwinbox Visualizer - a Power BI custom visual with fifteen chart types, a built-in dimension selector, a Monthly/Quarterly/Annual switch and a chart/table toggle.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-b2207/Darwinbox-Visualizer.git"
  },
  "author": "Darwinbox People Analytics <lokesh.l@darwinbox.in>",
  "license": "MIT",
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "package": "pbiviz package --all-locales",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "eslint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint": "npx eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "powerbi-visuals-api": "~5.11.0",
    "powerbi-visuals-utils-chartutils": "^8.3.0",
    "powerbi-visuals-utils-colorutils": "^7.0.0",
    "powerbi-visuals-utils-formattingmodel": "^7.1.0",
    "powerbi-visuals-utils-formattingutils": "^7.0.0",
    "powerbi-visuals-utils-interactivityutils": "^6.0.4",
    "powerbi-visuals-utils-tooltiputils": "^6.0.5",
    "tabulator-tables": "^6.3.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.19.0",
    "eslint-plugin-powerbi-visuals": "^1.1.1",
    "typescript": "^5.5.4"
  }
}
